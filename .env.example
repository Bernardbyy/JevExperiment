# Copy to .env and fill in. Never commit .env.

# --- API key --------------------------------------------------------------
# All four models go through OpenRouter - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Model slots ----------------------------------------------------------
# _MODEL  the OpenRouter slug to call - swap it to benchmark a different model
# _LABEL  names the CSV file and report column

JEV_MODEL=typesafe/jev-1.13
JEV_LABEL=jev

ANTHROPIC_MODEL=anthropic/claude-haiku-4.5
ANTHROPIC_LABEL=haiku

GEMINI_MODEL=google/gemini-3.5-flash-lite
GEMINI_LABEL=gemini

OPENAI_MODEL=openai/gpt-5.6-luna
OPENAI_LABEL=luna

# --- Jev decision threshold -----------------------------------------------
# Jev's noul is P(pass). At or above this it passes, below it blocks.
# 0.8 was chosen from early trial runs.
JEV_NOUL_THRESHOLD=0.8
